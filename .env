# Template .env — copy to .env.local and customize per machine
#LANGUAGE=language_for_UI_strings (if not set or left empty, en_US set as default)
#PUMP_NAME=DEFAULT_PUMP
#PORT_NAME=COM3

# Custom test suites (optional, for .env.local)
# Format: suite_name:test1,test2|suite_name2:test3
#CUSTOM_SUITES=my_combo:tm961,tm963|quick_test:medicationEmpty

# Xray credentials (optional, for .env.local)
#XRAY_CLIENT_ID=your_client_id_here
#XRAY_CLIENT_SECRET=your_client_secret_here
#XRAY_PROJECT_KEY=your_project_key_here
#XRAY_ENV_INFO=your_environment_info_here
